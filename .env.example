# ---------------------------------------------------------------------------
# Required settings
# ---------------------------------------------------------------------------

# Discord bot token
#
# 1. Create a Discord Application:
#    - Go to https://discord.com/developers/applications and click
#      "New Application".
# 2. Get your Bot Token:
#    - Go to the "Bot" tab on the left menu.
#    - Click "Reset Token", copy the generated token, and paste it below.
# 3. Enable Gateway Intents:
#    - Still in the "Bot" tab, scroll down to "Privileged Gateway Intents".
#    - Enable "Message Content Intent" (required if the bot reads message
#      text or uses prefixes).
# 4. Invite the Bot to your Server:
#    - Go to "OAuth2" -> "OAuth2 URL Generator"
#    - Under Scopes, select "bot" (and "applications.commands" if using
#      slash commands).
#    - Under Bot Permissions, select:
#        - View Channels
#        - Read Message History
#    - Under Integration Type, select "Guild Install".
#    - Copy the generated install link, open it in your browser, and select
#      your server.
# 5. Make sure your bot has permissions to see the channel you want to mirror.
DISCORD_BOT_TOKEN="AbCdEfGhIjKlMnOpQrStUvWxYz01234567890AbCdEfGhIjKlMnOpQrStUvWxYz012345678"

# StreamElements bearer token
#
# Log in to StreamElements and find it from your browser developer tools.
# Method 1: Network -> click any request to api.streamelements.com
#   -> Request Headers -> Authorization: Bearer AbCdEf...
# Method 2: Storage -> Cookies -> streamelements.com
#   -> se-token -> AbCdEf...
# In both cases, the "AbCdEf..." part is your bearer token. Paste it below.
SE_BEARER_TOKEN=""

# Discord Channel ID.
# 1. In Discord, choose User Settings -> Developer -> turn on Developer Mode.
# 2. Right-click on the channel, and then click Copy Channel ID. Paste it below.
DISCORD_CHANNEL_ID=0000000000000000000

# Name of the StreamElements custom command that you want to use
SE_COMMAND_NAME="stream"

# ---------------------------------------------------------------------------
# StreamElements channel: set one of these
# ---------------------------------------------------------------------------

# Optional. StreamElements Channel ID. When set, no lookup is performed.
#SE_CHANNEL_ID=

# Optional, but required when SE_CHANNEL_ID is empty.
# Twitch channel name (or numeric Twitch Channel ID); resolved and cached.
TWITCH_CHANNEL="MyTwitchChannelName"

# ---------------------------------------------------------------------------
# Optional settings
# ---------------------------------------------------------------------------

# Optional. StreamElements Command ID. When empty, it is looked up by
# SE_COMMAND_NAME and cached.
# Default: empty (lookup by name)
#SE_COMMAND_ID=

# Optional. How many recent Discord messages to mirror.
# Default: 5
#MESSAGE_LIMIT=5

# Optional. IANA timezone used to render Discord timestamps.
# https://nodatime.org/TimeZones
# Default: the environment's local timezone
#TIMEZONE="America/New_York"

# Optional. Label appended after timestamps.
# Default: "<TIMEZONE> time" (e.g. "America/New_York time")
#TIMEZONE_NAME="Big Apple time"

# Optional. If every mirrored message is by this Discord username, author names
# are omitted.
# Default: empty (author names are always shown)
#AUTHOR_OWNER="GarlicWare"
